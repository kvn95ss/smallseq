# Singularity definition for SmallSeq pipeline
Bootstrap: docker
From: ubuntu:22.04

%labels
    Author "Karthik+Antigravity"
    Version "1.0"
    Description "Lightweight Singularity image containing all tools to run the SmallSeq pipeline"

%post
    # Update package list and install system dependencies
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        cutadapt \
        python3 \
        python3-pip \
        gcc \
        make \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        wget \
        libncurses5-dev \
        libncursesw5-dev && \
    rm -rf /var/lib/apt/lists/*

    # Install required Python packages
    pip3 install --no-cache-dir pysam pyyaml umi_tools
    
    # Install Calib
    wget https://github.com/vpc-ccg/calib/archive/refs/tags/v0.3.7.tar.gz
    tar -xf v0.3.7.tar.gz
    cd calib-0.3.7
    make 
    cd ..
    mv calib-0.3.7 /opt/calib
    rm -rf v0.3.7.tar.gz

    # Download STAR
    mkdir -p /opt/smallseq/annotations
    wget https://github.com/alexdobin/STAR/archive/2.7.11b.tar.gz
    tar -xzf 2.7.11b.tar.gz
    mv STAR-2.7.11b /opt/smallseq
    rm -rf 2.7.11b.tar.gz

    # install samtools
    wget https://github.com/samtools/samtools/releases/download/1.23.1/samtools-1.23.1.tar.bz2
    tar -xjf samtools-1.23.1.tar.bz2
    cd samtools-1.23.1/
    ./configure && make && make install
    

%environment
    export PATH=/opt/smallseq:/opt/smallseq/STAR-2.7.11b/bin/Linux_x86_64:$PATH
    export PYTHONUNBUFFERED=1
